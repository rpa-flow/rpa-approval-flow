generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  AGUARDANDO_APROVACAO
  APROVADO
  RECUSADO
  PROCESSADO
  EXPIRADA
  DADOS_INCONSISTENTES
}

enum ProcessingStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  ERRO
}

enum DelphiIntegrationStatus {
  AGUARDANDO
  SUCESSO
  FALHA
}

enum InvoiceSituation {
  AUTORIZADA
  CANCELADA
}

enum UserRole {
  ADMIN
  GESTOR
  FORNECEDOR
}

enum SupplierRiskLevel {
  BAIXO
  MEDIO
  ALTO
}

enum NfseNsuStatus {
  Downloaded
  PendingGap
  RetryError
  IgnoredByRule
}

enum InvoiceAdminReviewStatus {
  PENDENTE
  LIBERADA
  IGNORADA
}

enum WorkflowDocumentType {
  NFSE
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
}

enum WorkflowFieldMode {
  HIDDEN
  READ_ONLY
  EDITABLE
}

enum WorkflowConsultationScope {
  ASSIGNED
  ALL
}

enum WorkflowExecutionStatus {
  ACTIVE
  COMPLETED
  BLOCKED
}

enum WorkflowNotificationStatus {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  UNCERTAIN
  SIMULATED
}


model Company {
  id          String   @id @default(cuid())
  cnpj        String   @unique
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nfseNsuCheckpoint NfseNsuCheckpoint?
  nfseNsuControls   NfseNsuControl[]

  @@index([active])
}

model Supplier {
  id                 String                       @id @default(cuid())
  nome               String
  cnpj               String?                      @unique
  codigoExterno      String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  managerSuppliers   ManagerSupplier[]
  invoices           Invoice[]
  notificationConfig SupplierNotificationConfig?
  categoryLinks      SupplierCategoryLink[]
}

model SupplierCategory {
  id          String   @id @default(cuid())
  nome        String   @unique
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplierLinks SupplierCategoryLink[]
}

model SupplierCategoryLink {
  id         String   @id @default(cuid())
  supplierId String
  categoryId String
  createdAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoryId])
  @@index([supplierId])
  @@index([categoryId])
}


model Manager {
  id               String            @id @default(cuid())
  nome             String
  email            String            @unique
  senhaHash        String
  role             UserRole          @default(GESTOR)
  ativo            Boolean           @default(true)
  acessoRelatorios Boolean           @default(false)
  managerSuppliers ManagerSupplier[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoicesCriadas  Invoice[]         @relation("InvoiceCreatedBy")
  activationTokens AccountActivationToken[]
  passwordResetTokens PasswordResetToken[]
  workflowSteps ApprovalWorkflowStep[]
  workflowTasks InvoiceWorkflowTask[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  managerId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  manager   Manager   @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
}

model AccountActivationToken {
  id        String    @id @default(cuid())
  managerId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  manager   Manager   @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
}

model ManagerSupplier {
  id         String   @id @default(cuid())
  managerId  String
  supplierId String
  createdAt  DateTime @default(now())

  manager    Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([managerId, supplierId])
  @@index([managerId])
  @@index([supplierId])
}

model Invoice {
  id                  String           @id @default(cuid())
  codigoIdentificador String           @unique
  documentType        WorkflowDocumentType?
  numeroNota          String
  nDfse               String?
  fornecedorId        String
  status              InvoiceStatus    @default(AGUARDANDO_APROVACAO)
  processada          Boolean          @default(false)
  statusProcessamento ProcessingStatus @default(PENDENTE)
  dataAtualizacao     DateTime         @updatedAt
  createdAt           DateTime         @default(now())
  tentativasNotificacao Int            @default(0)
  ultimoLembreteEm    DateTime?

  xmlOriginal         String?
  localEmissao        String?
  localPrestacao      String?
  municipioIncidencia String?
  itemTributacaoNac   String?
  itemTributacaoMun   String?
  nbsDescricao        String?
  descricaoServico    String?
  dataProcessamento   DateTime?
  dataEmissao         DateTime?
  dataCompetencia     DateTime?
  dataPagamento       DateTime?
  ordemCompra         String?
  ocContrato          String?
  numeroParcelas      Int              @default(1)
  dataLancamentoDelphi DateTime?
  codigoDelphi        String?
  statusIntegracaoDelphi DelphiIntegrationStatus @default(AGUARDANDO)
  situacaoNotaFiscal  InvoiceSituation @default(AUTORIZADA)
  responsavelValidacao String?
  dataValidacao       DateTime?
  observacaoValidacao String?

  prestadorCnpj       String?
  prestadorNome       String?
  prestadorEmail      String?
  tomadorCnpj         String?
  tomadorNome         String?
  tomadorEmail        String?

  valorBaseCalculo    Decimal?         @db.Decimal(14, 2)
  valorIssqn          Decimal?         @db.Decimal(14, 2)
  valorTotalRetido    Decimal?         @db.Decimal(14, 2)
  valorLiquido        Decimal?         @db.Decimal(14, 2)
  valorServico        Decimal?         @db.Decimal(14, 2)
  aliquota            Decimal?         @db.Decimal(5, 2)

  fornecedor          Supplier         @relation(fields: [fornecedorId], references: [id])
  criadoPor           Manager?         @relation("InvoiceCreatedBy", fields: [criadoPorId], references: [id])
  criadoPorId         String?
  statusHistory       NoteStatusHistory[]
  notifications       NoteNotification[]
  auditLogs           NoteAuditLog[]
  serviceEvaluation   ServiceEvaluation?
  documentDetail      InvoiceDocumentDetail?
  adminReview         InvoiceAdminReview?
  workflowExecution   InvoiceWorkflow?

  @@index([fornecedorId])
  @@index([codigoIdentificador])
  @@index([criadoPorId])
}

model InvoiceAdminReviewConfig {
  id        String   @id @default("default")
  email     String?
  ativo     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceAdminReview {
  id                  String                   @id @default(cuid())
  invoiceId           String                   @unique
  status              InvoiceAdminReviewStatus @default(PENDENTE)
  motivos             String[]                 @default([])
  mesReferencia       String
  valorSugerido       Decimal?                 @db.Decimal(14, 2)
  origemValor         String?
  evidenciaValor      String?
  valorConfirmado     Decimal?                 @db.Decimal(14, 2)
  emissaoConfirmada   Boolean                  @default(false)
  responsavelId       String?
  responsavelNome     String?
  responsavelEmail    String?
  justificativa       String?
  observacao          String?
  revisadoEm          DateTime?
  emailDestinatario   String?
  emailEnviadoEm      DateTime?
  tentativasEmail     Int                      @default(0)
  erroEmail           String?
  versao              Int                      @default(1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  invoice             Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([mesReferencia])
}

model InvoiceDocumentDetail {
  id              String   @id @default(cuid())
  invoiceId       String   @unique
  documentFamily  String
  layout          String
  layoutVersion   String?
  schemaVersion   Int      @default(1)
  additionalData  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([documentFamily, layout])
}

model ServiceEvaluation {
  id           String            @id @default(cuid())
  invoiceId    String            @unique
  managerId    String
  managerName  String
  managerEmail String
  rating       Int
  comment      String
  riskLevel    SupplierRiskLevel
  qualifica    Boolean?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoice      Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([managerId])
  @@index([riskLevel])
}


model NoteStatusHistory {
  id             String        @id @default(cuid())
  invoiceId      String
  actorId        String?
  actorName      String?
  actorEmail     String?
  previousStatus InvoiceStatus?
  newStatus      InvoiceStatus
  reason         String?
  createdAt      DateTime      @default(now())

  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model NoteNotification {
  id         String   @id @default(cuid())
  invoiceId  String
  recipients String[] @default([])
  sentAt     DateTime @default(now())
  success    Boolean  @default(true)
  error      String?

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sentAt])
}

model NoteAuditLog {
  id             String        @id @default(cuid())
  invoiceId      String
  actorId        String?
  actorName      String?
  actorEmail     String?
  actionType     String
  actionDescription String?
  previousStatus InvoiceStatus?
  newStatus      InvoiceStatus?
  reason         String?
  comment        String?
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime      @default(now())

  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model NotificationRule {
  id                    String   @id @default(cuid())
  diasLembrete          Int      @default(2)
  ativo                 Boolean  @default(true)
  destinatarioAdicional String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SupplierNotificationConfig {
  id              String   @id @default(cuid())
  supplierId      String   @unique
  ativo           Boolean  @default(true)
  recorrenciaDias Int      @default(2)
  emailsExtras    String[] @default([])
  ultimoEnvioEm   DateTime?
  proximoEnvioEm  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}


model NfseNsuCheckpoint {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  cnpj                     String   @unique
  lastContiguousNsu        BigInt
  highestScannedNsu        BigInt
  lastScanAt               DateTime?
  lastDocumentDownloadedAt DateTime?
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([lastScanAt])
  @@index([lastDocumentDownloadedAt])
}

model NfseNsuControl {
  id                    String        @id @default(cuid())
  companyId             String
  cnpj                  String
  nsu                   BigInt
  status                NfseNsuStatus
  attempts              Int           @default(0)
  firstAttemptAt        DateTime
  lastAttemptAt         DateTime
  lastHttpStatus        Int?
  lastError             String?
  documentId            String?
  accessKey             String?
  ignoreReason          String?
  wasLastAttemptScanned Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company               Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attemptsHistory       NfseNsuAttempt[]

  @@unique([companyId, nsu])
  @@unique([companyId, cnpj, nsu])
  @@index([companyId, status])
  @@index([companyId, nsu])
  @@index([companyId, lastAttemptAt])
  @@index([status, lastAttemptAt])
  @@index([status, firstAttemptAt])
}

model NfseNsuAttempt {
  id              String        @id @default(cuid())
  nsuControlId    String
  idempotencyKey  String        @unique
  resultStatus    NfseNsuStatus
  httpStatus      Int?
  errorMessage    String?
  wasNsuScanned   Boolean
  documentId      String?
  accessKey       String?
  ignoreReason    String?
  attemptedAt                     DateTime
  effectiveStateChanged           Boolean       @default(false)
  ignoredBecauseAlreadyDownloaded Boolean       @default(false)
  createdAt                       DateTime       @default(now())

  nsuControl       NfseNsuControl @relation(fields: [nsuControlId], references: [id], onDelete: Cascade)

  @@index([nsuControlId, attemptedAt])
  @@index([resultStatus, attemptedAt])
}

model ApprovalWorkflow {
  id            String @id @default(cuid())
  documentType  WorkflowDocumentType @unique
  activeVersionId String? @unique
  activatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versions      ApprovalWorkflowVersion[] @relation("WorkflowVersions")
  activeVersion ApprovalWorkflowVersion? @relation("ActiveWorkflowVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
}

model ApprovalWorkflowVersion {
  id          String @id @default(cuid())
  workflowId  String
  number      Int
  status      WorkflowVersionStatus @default(DRAFT)
  revision    Int @default(1)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workflow    ApprovalWorkflow @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Restrict)
  activeFor   ApprovalWorkflow? @relation("ActiveWorkflowVersion")
  steps       ApprovalWorkflowStep[]
  executions  InvoiceWorkflow[]
  @@unique([workflowId, number])
}

model ApprovalWorkflowStep {
  id                    String @id @default(cuid())
  versionId             String
  name                  String
  position              Int
  managerId             String
  consultationScope     WorkflowConsultationScope @default(ASSIGNED)
  requiresPurchaseOrder Boolean @default(false)
  version               ApprovalWorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  manager               Manager @relation(fields: [managerId], references: [id], onDelete: Restrict)
  fields                ApprovalStepFieldPolicy[]
  tasks                 InvoiceWorkflowTask[]
  @@unique([versionId, position])
  @@index([managerId])
}

model ApprovalStepFieldPolicy {
  id       String @id @default(cuid())
  stepId   String
  fieldKey String
  mode     WorkflowFieldMode
  required Boolean @default(false)
  step     ApprovalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  @@unique([stepId, fieldKey])
}

model InvoiceWorkflow {
  id          String @id @default(cuid())
  invoiceId   String @unique
  versionId   String
  status      WorkflowExecutionStatus @default(ACTIVE)
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  version     ApprovalWorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  tasks       InvoiceWorkflowTask[]
  commands    WorkflowCommand[]
  @@index([status, createdAt])
}

model InvoiceWorkflowTask {
  id             String @id @default(cuid())
  executionId    String
  stepId         String
  managerId      String
  managerName    String
  managerEmail   String
  assignedAt     DateTime @default(now())
  completedAt    DateTime?
  execution      InvoiceWorkflow @relation(fields: [executionId], references: [id], onDelete: Restrict)
  step           ApprovalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  manager        Manager @relation(fields: [managerId], references: [id], onDelete: Restrict)
  notifications  WorkflowNotification[]
  @@unique([executionId, stepId])
  @@index([managerId, completedAt])
}

model WorkflowCommand {
  id             String @id @default(cuid())
  executionId    String
  idempotencyKey String
  actorId        String
  action         String
  payloadHash    String
  result         Json
  createdAt      DateTime @default(now())
  execution      InvoiceWorkflow @relation(fields: [executionId], references: [id], onDelete: Restrict)
  @@unique([executionId, idempotencyKey])
}

model WorkflowConfigurationAudit {
  id          String @id @default(cuid())
  workflowId  String
  versionId   String?
  actorId     String
  actorName   String
  action      String
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())
  @@index([workflowId, createdAt])
}

model WorkflowNotification {
  id              String @id @default(cuid())
  taskId          String
  deduplicationKey String @unique
  recipient       String
  payload         Json
  status          WorkflowNotificationStatus @default(PENDING)
  availableAt     DateTime @default(now())
  leaseUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  task            InvoiceWorkflowTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempts        WorkflowNotificationAttempt[]
  @@index([status, availableAt])
}

model WorkflowNotificationAttempt {
  id             String @id @default(cuid())
  notificationId String
  status         WorkflowNotificationStatus
  error          String?
  createdAt      DateTime @default(now())
  notification   WorkflowNotification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  @@index([notificationId, createdAt])
}
